#!/data/data/com.termux/files/usr/bin/sh
set -eu

BASE_URL="https://github.com/tizikernel/BYPASS-WALL/raw/main"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ARCH=$(uname -m 2>/dev/null || printf 'desconocida')

case "$ARCH" in
    aarch64|arm64)
        TARGET="aarch64"
        ;;
    armv7l|armv8l|arm)
        TARGET="armv7"
        ;;
    x86_64|amd64)
        TARGET="x86_64"
        ;;
    i386|i486|i586|i686|x86)
        TARGET="x86"
        ;;
    *)
        printf '%s\n' "[ERROR] Arquitectura no compatible: $ARCH" >&2
        printf '%s\n' '[INFO] Arquitecturas disponibles: aarch64, armv7, x86_64, x86.' >&2
        exit 1
        ;;
esac

BINARY_NAME="wall-$TARGET"
LOCAL_BINARY="$SCRIPT_DIR/$BINARY_NAME"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wall-private"
CACHED_BINARY="$CACHE_DIR/$BINARY_NAME"

if [ -x "$LOCAL_BINARY" ]; then
    exec "$LOCAL_BINARY" "$@"
fi

if [ -x "$CACHED_BINARY" ]; then
    exec "$CACHED_BINARY" "$@"
fi

mkdir -p "$CACHE_DIR"
TEMP_BINARY="$CACHED_BINARY.tmp.$$"
URL="$BASE_URL/$BINARY_NAME"

if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 2 -o "$TEMP_BINARY" "$URL"
elif command -v wget >/dev/null 2>&1; then
    wget -O "$TEMP_BINARY" "$URL"
else
    printf '%s\n' '[ERROR] No se encontró curl ni wget para descargar el binario.' >&2
    exit 1
fi

chmod 700 "$TEMP_BINARY"
mv -f "$TEMP_BINARY" "$CACHED_BINARY"
exec "$CACHED_BINARY" "$@"
